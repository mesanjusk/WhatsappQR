# MongoDB connection string. Used for: app data (chats/messages/session metadata)
# AND the whatsapp-web.js RemoteAuth session store (GridFS), so the WhatsApp
# login survives server restarts without re-scanning the QR code.
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_clone

# Public base URL of this Next.js app (used for building absolute links / CORS-safe defaults).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port the custom Node server listens on.
PORT=3000

# --- App authentication (single admin user for this MVP) ---
# The only credentials allowed to log into the dashboard and control the WhatsApp session.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Secret used to sign the app's login session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- WhatsApp / Puppeteer ---
# Fixed identifier for the single WhatsApp session this MVP manages.
WHATSAPP_SESSION_ID=default

# Optional: path to a system Chromium/Chrome binary. Leave unset to use the
# Chromium bundled with Puppeteer. Set this in Docker/Linux production images
# that install their own Chromium (e.g. /usr/bin/chromium).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# How often (ms) the WhatsApp session is backed up to MongoDB. Minimum 60000 (1 minute).
WHATSAPP_BACKUP_SYNC_INTERVAL_MS=300000
